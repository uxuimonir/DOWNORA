# Port the API listens on.
PORT=8787
# Comma-separated origins allowed to call the API with cookies (the web app).
CORS_ORIGINS=http://localhost:5173
# Requests per minute per client IP.
RATE_LIMIT_PER_MINUTE=240
# Where the SQLite database and job files live.
DATA_DIR=./.data
# Largest file a server job may fetch, in MB.
# MAX_FILE_MB=1024
# Minutes a finished job's file is kept.
# JOB_TTL_MIN=60
# Server conversions run at once.
# CONCURRENT_JOBS=2
# Set to 1 behind HTTPS so the session cookie is Secure.
# COOKIE_SECURE=true
# DEV/TEST ONLY: comma-separated hosts the SSRF guard may reach even though they
# are private (e.g. localhost). Ignored when NODE_ENV=production. Never set in production.
# ALLOW_PRIVATE_HOSTS=localhost
# One-server deploy: serve the built web app from here, and say where it lives.
# WEB_DIR=../web/dist
# PUBLIC_ORIGIN=https://downora.example.com
